// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
enum Rol {
  ADMINISTRADOR
  EMPLEADO
  SOCIO
}

enum TipoTurno {
  MATUTINO
  VESPERTINO
}

enum EstadoTurno {
  ABIERTO
  CERRADO
}

model Usuario {
  id            Int      @id @default(autoincrement())
  nombre        String
  usuario       String   @unique
  contrasena    String
  rol           Rol
  activo        Boolean  @default(true)
  fechaCreacion DateTime @default(now())

turnos          Turno[]
  movimientos     MovimientoInventario[]
  ventas          Venta[]
  apartados       Apartado[]
  apartadoAbonos  ApartadoAbono[]
  
  @@map("usuarios")
}

model Turno {
  id             Int         @id @default(autoincrement())
  tipo           TipoTurno
  usuarioId      Int
  usuario        Usuario     @relation(fields: [usuarioId], references: [id])
  fechaApertura  DateTime    @default(now())
  horaApertura   String
  fechaCierre    DateTime?
  horaCierre     String?
  estado         EstadoTurno @default(ABIERTO)
  ventas Venta[]

  @@map("turnos")
}
enum Material {
  ORO
  PLATA
  ORO_LAMINADO
}

enum EstadoProducto {
  DISPONIBLE
  APARTADO
  VENDIDO
  CANCELADO
}

enum TipoMovimiento {
  ENTRADA
  VENTA
  DEVOLUCION
  APARTADO
  CANCELACION
  AJUSTE
}

model CodigoPrecio {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique
  precio    Decimal  @db.Decimal(10, 2)

  productos Producto[]

  @@map("codigos_precio")
}

model Producto {
  id              Int            @id @default(autoincrement())
  sku             String         @unique
  codigoPrecioId  Int
  codigoPrecio    CodigoPrecio   @relation(fields: [codigoPrecioId], references: [id])
  nombre          String
  descripcion     String?
  material        Material
  tipo            String
  existencia      Int            @default(0)
  estado          EstadoProducto @default(DISPONIBLE)
  fechaCreacion   DateTime       @default(now())

  movimientos     MovimientoInventario[]
  ventaDetalles   VentaDetalle[]
  apartados       Apartado[]

  @@map("productos")
}

model MovimientoInventario {
  id             Int            @id @default(autoincrement())
  productoId     Int
  producto       Producto       @relation(fields: [productoId], references: [id])
  tipoMovimiento TipoMovimiento
  cantidad       Int
  usuarioId      Int
  usuario        Usuario        @relation(fields: [usuarioId], references: [id])
  fecha          DateTime       @default(now())
  referencia     String?
  nota           String?

  @@map("movimientos_inventario")
}
enum TipoVenta {
  MENUDEO
  MAYOREO
}

enum EstadoVenta {
  COMPLETADA
  CANCELADA
  CON_DEVOLUCION
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  DEPOSITO
}

enum EstadoApartado {
  ACTIVO
  LIQUIDADO
  ENTREGADO
  CANCELADO
}

model Venta {
  id          Int         @id @default(autoincrement())
  folio       String      @unique
  usuarioId   Int
  usuario     Usuario     @relation(fields: [usuarioId], references: [id])
  turnoId     Int
  turno       Turno       @relation(fields: [turnoId], references: [id])
  tipoVenta   TipoVenta
  mayoristaId Int?
  subtotal    Decimal     @db.Decimal(10, 2)
  descuento   Decimal     @default(0) @db.Decimal(10, 2)
  total       Decimal     @db.Decimal(10, 2)
  fecha       DateTime    @default(now())
  estado      EstadoVenta @default(COMPLETADA)

  detalles VentaDetalle[]
  pagos    VentaPago[]

  @@map("ventas")
}

model VentaDetalle {
  id             Int      @id @default(autoincrement())
  ventaId        Int
  venta          Venta    @relation(fields: [ventaId], references: [id])
  productoId     Int
  producto       Producto @relation(fields: [productoId], references: [id])
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(10, 2)

  @@map("venta_detalle")
}

model VentaPago {
  id         Int        @id @default(autoincrement())
  ventaId    Int
  venta      Venta      @relation(fields: [ventaId], references: [id])
  metodoPago MetodoPago
  monto      Decimal    @db.Decimal(10, 2)

  @@map("venta_pagos")
}

model Apartado {
  id              Int            @id @default(autoincrement())
  folio           String         @unique
  productoId      Int
  producto        Producto       @relation(fields: [productoId], references: [id])
  clienteNombre   String
  clienteTelefono String
  usuarioId       Int
  usuario         Usuario        @relation(fields: [usuarioId], references: [id])
  precioTotal     Decimal        @db.Decimal(10, 2)
  anticipo        Decimal        @db.Decimal(10, 2)
  saldoPendiente  Decimal        @db.Decimal(10, 2)
  estado          EstadoApartado @default(ACTIVO)
  fechaApartado   DateTime       @default(now())

  abonos ApartadoAbono[]

  @@map("apartados")
}

model ApartadoAbono {
  id         Int        @id @default(autoincrement())
  apartadoId Int
  apartado   Apartado   @relation(fields: [apartadoId], references: [id])
  monto      Decimal    @db.Decimal(10, 2)
  metodoPago MetodoPago
  usuarioId  Int
  usuario    Usuario    @relation(fields: [usuarioId], references: [id])
  fecha      DateTime   @default(now())

  @@map("apartado_abonos")
}