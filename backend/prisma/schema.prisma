// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
enum Rol {
  ADMINISTRADOR
  EMPLEADO
  SOCIO
}

enum TipoTurno {
  MATUTINO
  VESPERTINO
}

enum EstadoTurno {
  ABIERTO
  CERRADO
}

model Usuario {
  id            Int      @id @default(autoincrement())
  nombre        String
  usuario       String   @unique
  contrasena    String
  rol           Rol
  activo        Boolean  @default(true)
  fechaCreacion DateTime @default(now())

  turnos Turno[]
  movimientos MovimientoInventario[]

  @@map("usuarios")
}

model Turno {
  id             Int         @id @default(autoincrement())
  tipo           TipoTurno
  usuarioId      Int
  usuario        Usuario     @relation(fields: [usuarioId], references: [id])
  fechaApertura  DateTime    @default(now())
  horaApertura   String
  fechaCierre    DateTime?
  horaCierre     String?
  estado         EstadoTurno @default(ABIERTO)

  @@map("turnos")
}
enum Material {
  ORO
  PLATA
  ORO_LAMINADO
}

enum EstadoProducto {
  DISPONIBLE
  APARTADO
  VENDIDO
  CANCELADO
}

enum TipoMovimiento {
  ENTRADA
  VENTA
  DEVOLUCION
  APARTADO
  CANCELACION
  AJUSTE
}

model CodigoPrecio {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique
  precio    Decimal  @db.Decimal(10, 2)

  productos Producto[]

  @@map("codigos_precio")
}

model Producto {
  id              Int            @id @default(autoincrement())
  sku             String         @unique
  codigoPrecioId  Int
  codigoPrecio    CodigoPrecio   @relation(fields: [codigoPrecioId], references: [id])
  nombre          String
  descripcion     String?
  material        Material
  tipo            String
  existencia      Int            @default(0)
  estado          EstadoProducto @default(DISPONIBLE)
  fechaCreacion   DateTime       @default(now())

  movimientos     MovimientoInventario[]

  @@map("productos")
}

model MovimientoInventario {
  id             Int            @id @default(autoincrement())
  productoId     Int
  producto       Producto       @relation(fields: [productoId], references: [id])
  tipoMovimiento TipoMovimiento
  cantidad       Int
  usuarioId      Int
  usuario        Usuario        @relation(fields: [usuarioId], references: [id])
  fecha          DateTime       @default(now())
  referencia     String?
  nota           String?

  @@map("movimientos_inventario")
}