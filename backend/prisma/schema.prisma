// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
enum Rol {
  ADMINISTRADOR
  EMPLEADO
  SOCIO
}

enum TipoTurno {
  MATUTINO
  VESPERTINO
}

enum EstadoTurno {
  ABIERTO
  CERRADO
}

model Usuario {
  id            Int      @id @default(autoincrement())
  nombre        String
  usuario       String   @unique
  contrasena    String
  rol           Rol
  activo        Boolean  @default(true)
  fechaCreacion DateTime @default(now())

turnos          Turno[]
  movimientos     MovimientoInventario[]
  ventas          Venta[]
  apartados       Apartado[]
  apartadoAbonos  ApartadoAbono[]
  gastos          Gasto[]
  cortes          Corte[]
  auditorias      Auditoria[]
  creditosMayorista CreditoMayorista[]

  @@map("usuarios")
}

model Turno {
  id             Int         @id @default(autoincrement())
  tipo           TipoTurno
  usuarioId      Int
  usuario        Usuario     @relation(fields: [usuarioId], references: [id])
  fechaApertura  DateTime    @default(now())
  horaApertura   String
  fechaCierre    DateTime?
  horaCierre     String?
  estado         EstadoTurno @default(ABIERTO)
  ventas Venta[]
  gastos Gasto[]
  corte  Corte?

  @@map("turnos")
}
enum Material {
  ORO
  PLATA
  ORO_LAMINADO
  ACERO
  OTRO
}

enum EstadoProducto {
  DISPONIBLE
  APARTADO
  VENDIDO
  CANCELADO
}

enum TipoMovimiento {
  ENTRADA
  VENTA
  DEVOLUCION
  APARTADO
  CANCELACION
  AJUSTE
}

model CodigoPrecio {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique
  precio    Decimal  @db.Decimal(10, 2)

  productos Producto[]

  @@map("codigos_precio")
}

model Producto {
  id              Int            @id @default(autoincrement())
  sku             String         @unique
  codigoPrecioId  Int
  codigoPrecio    CodigoPrecio   @relation(fields: [codigoPrecioId], references: [id])
  nombre          String
  descripcion     String?
  material        Material
  tipo            String
  existencia      Int            @default(0)
  estado          EstadoProducto @default(DISPONIBLE)
  fechaCreacion   DateTime       @default(now())

  movimientos     MovimientoInventario[]
  ventaDetalles   VentaDetalle[]
  apartados       Apartado[]
  creditoDetalles CreditoMayoristaProducto[]

  @@map("productos")
}

model MovimientoInventario {
  id             Int            @id @default(autoincrement())
  productoId     Int
  producto       Producto       @relation(fields: [productoId], references: [id])
  tipoMovimiento TipoMovimiento
  cantidad       Int
  usuarioId      Int
  usuario        Usuario        @relation(fields: [usuarioId], references: [id])
  fecha          DateTime       @default(now())
  referencia     String?
  nota           String?

  @@map("movimientos_inventario")
}
enum TipoVenta {
  MENUDEO
  MAYOREO
}

enum EstadoVenta {
  COMPLETADA
  CANCELADA
  CON_DEVOLUCION
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  DEPOSITO
}

enum EstadoApartado {
  ACTIVO
  LIQUIDADO
  ENTREGADO
  CANCELADO
}

model Venta {
  id          Int         @id @default(autoincrement())
  folio       String      @unique
  usuarioId   Int
  usuario     Usuario     @relation(fields: [usuarioId], references: [id])
  turnoId     Int
  turno       Turno       @relation(fields: [turnoId], references: [id])
  tipoVenta   TipoVenta
  mayoristaId Int?
  mayorista   Mayorista? @relation(fields: [mayoristaId], references: [id])
  subtotal    Decimal     @db.Decimal(10, 2)
  descuento   Decimal     @default(0) @db.Decimal(10, 2)
  total       Decimal     @db.Decimal(10, 2)
  fecha       DateTime    @default(now())
  estado      EstadoVenta @default(COMPLETADA)

  detalles VentaDetalle[]
  pagos    VentaPago[]
  compraMayorista MayoristaCompra?
  tickets         Ticket[]
  credito         CreditoMayorista?

  @@map("ventas")
}

model VentaDetalle {
  id             Int      @id @default(autoincrement())
  ventaId        Int
  venta          Venta    @relation(fields: [ventaId], references: [id])
  productoId     Int
  producto       Producto @relation(fields: [productoId], references: [id])
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(10, 2)

  @@map("venta_detalle")
}

model VentaPago {
  id         Int        @id @default(autoincrement())
  ventaId    Int
  venta      Venta      @relation(fields: [ventaId], references: [id])
  metodoPago MetodoPago
  monto      Decimal    @db.Decimal(10, 2)

  @@map("venta_pagos")
}

model Apartado {
  id              Int            @id @default(autoincrement())
  folio           String         @unique
  productoId      Int
  producto        Producto       @relation(fields: [productoId], references: [id])
  clienteNombre   String
  clienteTelefono String
  usuarioId       Int
  usuario         Usuario        @relation(fields: [usuarioId], references: [id])
  precioTotal     Decimal        @db.Decimal(10, 2)
  anticipo        Decimal        @db.Decimal(10, 2)
  saldoPendiente  Decimal        @db.Decimal(10, 2)
  estado          EstadoApartado @default(ACTIVO)
  fechaApartado   DateTime       @default(now())

  abonos ApartadoAbono[]

  @@map("apartados")
}

model ApartadoAbono {
  id         Int        @id @default(autoincrement())
  apartadoId Int
  apartado   Apartado   @relation(fields: [apartadoId], references: [id])
  monto      Decimal    @db.Decimal(10, 2)
  metodoPago MetodoPago
  usuarioId  Int
  usuario    Usuario    @relation(fields: [usuarioId], references: [id])
  fecha      DateTime   @default(now())

  @@map("apartado_abonos")
}
enum EstadoMayorista {
  ACTIVO
  SUSPENDIDO
}
enum TipoBeneficioMayorista {
  NORMAL
  SIN_CARPETA
  ESPECIAL
}

model Mayorista {
  id                     Int             @id @default(autoincrement())
  numeroCliente          String          @unique
  nombreCompleto         String
  telefono               String
  estado                 EstadoMayorista         @default(ACTIVO)
  tipoBeneficio           TipoBeneficioMayorista  @default(NORMAL)
  totalAcumuladoPeriodo  Decimal         @default(0) @db.Decimal(10, 2)
  fechaUltimaCompra      DateTime?
  fechaRegistro          DateTime        @default(now())

  compras  MayoristaCompra[]
  ventas   Venta[]
  creditos CreditoMayorista[]

  @@map("mayoristas")
}

model MayoristaCompra {
  id                Int       @id @default(autoincrement())
  mayoristaId       Int
  mayorista         Mayorista @relation(fields: [mayoristaId], references: [id])
  ventaId           Int       @unique
  venta             Venta     @relation(fields: [ventaId], references: [id])
  monto             Decimal   @db.Decimal(10, 2)
  fecha             DateTime  @default(now())
  carpetaEntregada  Boolean   @default(false)

  @@map("mayorista_compras")
}

model Gasto {
  id         Int        @id @default(autoincrement())
  categoria  String
  concepto   String
  monto      Decimal    @db.Decimal(10, 2)
  metodoPago MetodoPago
  usuarioId  Int
  usuario    Usuario    @relation(fields: [usuarioId], references: [id])
  turnoId    Int
  turno      Turno      @relation(fields: [turnoId], references: [id])
  fecha      DateTime   @default(now())

  @@map("gastos")
}

model Corte {
  id                   Int      @id @default(autoincrement())
  turnoId              Int      @unique
  turno                Turno    @relation(fields: [turnoId], references: [id])
  totalVentas          Decimal  @db.Decimal(10, 2)
  totalGastos          Decimal  @db.Decimal(10, 2)
  totalDevoluciones    Decimal  @db.Decimal(10, 2)
  totalEfectivo        Decimal  @db.Decimal(10, 2)
  totalTarjeta         Decimal  @db.Decimal(10, 2)
  totalTransferencia   Decimal  @db.Decimal(10, 2)
  totalDeposito        Decimal  @db.Decimal(10, 2)
  totalFinal           Decimal  @db.Decimal(10, 2)
  usuarioId            Int
  usuario              Usuario  @relation(fields: [usuarioId], references: [id])
  fecha                DateTime @default(now())

  @@map("cortes")
}
enum TipoTicket {
  DIGITAL
  FISICO
}

model Auditoria {
  id             Int      @id @default(autoincrement())
  usuarioId      Int
  usuario        Usuario  @relation(fields: [usuarioId], references: [id])
  accion         String
  tablaAfectada  String
  registroId     Int
  detalle        String?
  fecha          DateTime @default(now())

  @@map("auditoria")
}

model Ticket {
  id               Int        @id @default(autoincrement())
  ventaId          Int
  venta            Venta      @relation(fields: [ventaId], references: [id])
  tipo             TipoTicket
  enviadoWhatsapp  Boolean    @default(false)
  telefonoEnvio    String?
  fechaGenerado    DateTime   @default(now())
  fechaEnviado     DateTime?

  @@map("tickets")
}

enum EstadoCredito {
  ACTIVO
  LIQUIDADO
  CANCELADO
}

model CreditoMayorista {
  id               Int           @id @default(autoincrement())
  folio            String        @unique
  mayoristaId      Int
  mayorista        Mayorista     @relation(fields: [mayoristaId], references: [id])
  totalCredito     Decimal       @db.Decimal(10, 2)
  totalVendido     Decimal?      @db.Decimal(10, 2)
  fechaEntrega     DateTime      @default(now())
  fechaLimite      DateTime
  fechaLiquidacion DateTime?
  estado           EstadoCredito @default(ACTIVO)
  usuarioId        Int
  usuario          Usuario       @relation(fields: [usuarioId], references: [id])

    productos CreditoMayoristaProducto[]
  ventaId   Int?    @unique
  venta     Venta?  @relation(fields: [ventaId], references: [id])

  @@map("creditos_mayorista")
}

model CreditoMayoristaProducto {
  id              Int              @id @default(autoincrement())
  creditoId       Int
  credito         CreditoMayorista @relation(fields: [creditoId], references: [id])
  productoId      Int
  producto        Producto         @relation(fields: [productoId], references: [id])
  precioAlMomento Decimal          @db.Decimal(10, 2)
  devuelto        Boolean          @default(false)

  @@map("credito_mayorista_productos")
}